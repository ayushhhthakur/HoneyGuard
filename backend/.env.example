# ---- Server ----
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# How many reverse-proxy hops to trust for X-Forwarded-For (1 on most PaaS)
TRUST_PROXY_HOPS=1
# This server's own public URL, embedded as the canary callback target in
# generated Word/Excel/PowerPoint/PDF/HTML honeydocuments. Must be publicly
# reachable once you're deploying real honeytokens (not localhost).
PUBLIC_BASE_URL=http://localhost:5000

# ---- Supabase (Project Settings -> API) ----
SUPABASE_URL=https://your-project.supabase.co
# Service role key — server-side ONLY, never expose to the frontend
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Cloudflare R2 (for image-category honeytoken uploads) ----
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=honeyguard-images
# Public dev subdomain (Settings -> Public access on the bucket) or a custom domain
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# ---- Email notifications (optional — leave blank to disable) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
ALERT_FROM_NAME=HoneyGuard Security
# Comma-separated list of addresses to notify on suspicious activity
ALERT_EMAILS=

# ---- Internal webhooks ----
# Shared secret the Supabase `notify-alert` edge function must send back to
# POST /internal/notify-alert-email. Generate with: openssl rand -hex 32
ALERT_WEBHOOK_SECRET=
